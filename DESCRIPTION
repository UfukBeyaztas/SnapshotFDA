Package: SnapshotFDA
Type: Package
Title: Covariance of a Random Function from One Observation per Curve
Version: 0.1.0
Authors@R: c(
    person("Ufuk", "Beyaztas", email = "ufuk.beyaztas@marmara.edu.tr",
           role = c("aut", "cre"), comment = c(ORCID = "0000-0002-5208-4950")),
    person("Mina", "Norouzirad", email = "m.norouzirad@fct.unl.pt",
